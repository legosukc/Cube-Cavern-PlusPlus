#version 100

attribute vec2 aPos;
attribute vec2 aTexcoord;

uniform float AspectRatioReciprocal;
uniform vec2 Offset;
uniform vec2 TexcoordScale;

varying vec2 Texcoord;

void main() {
    gl_Position = vec4(Offset + aPos.xy * 0.075, 1.0, 1.0);
    gl_Position.x *= AspectRatioReciprocal;
    Texcoord = aTexcoord * TexcoordScale;
}