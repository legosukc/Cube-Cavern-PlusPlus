{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compile Client for local platform",
            "detail": "Spits out an executable named 'CubeCavern' to /build/.",
            "type": "shell",
            "command": "./compile-client.sh",
            "group": "build"
        },
        {
            "label": "Compile Server for local platform",
            "detail": "Spits out an executable named 'CubeCavern-DedicatedServer' to /build/.",
            "type": "shell",
            "command": "./compile-server.sh",
            "group": "build"
        },
        {
            "label": "Compile Both for local platform",
            "dependsOn": [
                "Compile Client",
                "Compile Server"
            ],
            "group": "build"
        },
        {
            "label": "Compile Client for PSVita",
            "detail": "Spits out a .vpk named 'CubeCavern' to /build/.",
            "type": "shell",
            "command": "/bin/bash ./compile-client-vita.sh",
            "group": "build"
        },
        {
            "label": "Compile Server for PSVita",
            "detail": "Spits out a .vpk named 'CubeCavern-DedicatedServer' to /build/.",
            "type": "shell",
            "command": "/bin/bash ./compile-server-vita.sh",
            "group": "build"
        },
        {
            "label": "Compile Both for PSVita",
            "dependsOn": [
                "Compile Client for PSVita",
                "Compile Server for PSVita"
            ],
            "group": "build"
        },
    ]
}