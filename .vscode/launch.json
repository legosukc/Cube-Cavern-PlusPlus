    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Client (Local platform)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceRoot}/build/CubeCavern",
            "args": [],
            "cwd": "${workspaceRoot}/ccbeyond-assets/"
        },
        {
            "name": "Launch Server (Local platform)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceRoot}/build/CubeCavern-DedicatedServer",
            "args": [],
            "cwd": "${workspaceRoot}/build/"
        },
        {
            "name": "Launch Client (Vita)",
            "type": "node-terminal",
            "request": "launch",
            "command": "~/Games/Vita3K-x86_64.AppImage -r WORM02011 build-vita/CubeCavern.vpk",
            "cwd": "${workspaceRoot}/"
        }
    ]
}